    "paid.features": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回顾历周阅读汇总。设置、调整和分享每周阅读分钟目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回顧歷週閱讀摘要。設定、調整和分享每週閱讀分鐘目標。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "See your past weeks at a glance. Set, edit and share a weekly reading goal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の週をひと目で確認。1週間の読書目標を設定・編集・共有できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난 주들을 한눈에 보세요. 주간 독서 목표를 정하고, 고치고, 공유하세요."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh deine früheren Wochen auf einen Blick. Lege ein Wochenziel fest, bearbeite und teile es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve tus semanas anteriores de un vistazo. Define, edita y comparte una meta semanal."
          }
        }
      }
    },
