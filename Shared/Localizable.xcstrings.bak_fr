    "paid.terms": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收费版首次打开即开始 30 天免费试用。领取凭证可用于恢复试用起点。一次性买断，无订阅，试用结束不会自动扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收費版首次開啟即開始 30 天免費試用。領取憑證可用於回復試用起點。一次性買斷，沒有訂閱，試用結束不會自動扣款。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your 30-day free trial starts when you first open the paid version. Claim a receipt to help restore your trial start date. The unlock is a one-time purchase, with no subscription or automatic charge."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "30日間の無料お試しは、有料版を初めて開いた日から始まります。レシートを受け取ると、お試し開始日の復元に役立ちます。解放は一度きりの購入で、サブスクや自動課金はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "30일 무료 체험은 유료 버전을 처음 열 때 시작됩니다. 영수증을 받아 두면 체험 시작일을 복원할 수 있습니다. 잠금 해제는 한 번 구매이며 구독이나 자동 결제가 없습니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine 30-tägige Testphase beginnt beim ersten Öffnen der Kaufversion. Hol dir einen Beleg, damit der Teststart wiederhergestellt werden kann. Die Freischaltung ist ein Einmalkauf, ohne Abo und ohne automatische Abbuchung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu prueba gratis de 30 días empieza al abrir por primera vez la versión de pago. Obtén un recibo para ayudar a restaurar la fecha de inicio. El desbloqueo es una compra única, sin suscripción ni cobro automático."
          }
        }
      }
    },
