    "settings.privacyBody": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "书名、页码、计时和目标保存在此设备。应用没有账号、广告、统计或服务器，也不会上传你的阅读数据。只有你主动分享或导出时，才会生成可交给系统分享的图片或 CSV。购买和恢复由 Apple 的 App Store 处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "書名、頁碼、計時和目標儲存在這部裝置。App 沒有帳號、廣告、統計或伺服器，也不會上傳閱讀資料。只有你主動分享或匯出時，才會產生可交給系統分享的圖片或 CSV。購買和回復由 Apple 的 App Store 處理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Book titles, pages, reading times and goals are stored on this device. There are no accounts, ads, analytics or servers, and the app does not upload your reading data. When you choose to share or export, the app prepares an image or CSV for the system share sheet. Apple’s App Store handles purchases and restoration."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書名、ページ、読書時間、目標はこの端末内に保存されます。アカウント、広告、分析ツール、サーバーはなく、読書のデータをアップロードすることはありません。共有や書き出しを選んだときだけ、画像やCSVをシステムの共有シート用に作成します。購入と復元はAppleのApp Storeが処理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "책 제목, 쪽수, 읽은 시간, 목표는 이 기기에 저장됩니다. 계정, 광고, 분석, 서버가 없고 독서 데이터를 업로드하지 않습니다. 공유하거나 내보내기를 고르면 시스템 공유 시트용 이미지나 CSV를 만듭니다. 구매와 복원은 Apple App Store가 처리합니다."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Buchtitel, Seiten, Lesezeiten und Ziele werden auf diesem Gerät gespeichert. Kein Konto, keine Werbung, keine Analyse, keine Server – die App lädt deine Lesedaten nicht hoch. Wenn du teilst oder exportierst, bereitet die App ein Bild oder eine CSV für das Teilen-Menü vor. Käufe und Wiederherstellung laufen über Apples App Store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los títulos, páginas, tiempos y metas se guardan en este dispositivo. Sin cuentas, anuncios, analíticas ni servidores, y la app no sube tus datos de lectura. Cuando compartes o exportas, la app prepara una imagen o un CSV para el menú de compartir. El App Store de Apple gestiona compras y restauración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les titres, pages, temps de lecture et objectifs sont stockés sur cet appareil. Pas de compte, de publicité, d’analyse ni de serveur, et l’app n’envoie pas tes données de lecture. Quand tu choisis de partager ou d’exporter, l’app prépare une image ou un CSV pour la feuille de partage. L’App Store d’Apple gère les achats et la restauration."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Títulos, páginas, tempos de leitura e metas ficam armazenados neste dispositivo. Sem contas, anúncios, análises ou servidores, e o app não envia seus dados de leitura. Quando você escolhe compartilhar ou exportar, o app prepara uma imagem ou CSV para a planilha de compartilhamento. A App Store da Apple cuida das compras e restaurações."
          }
        }
      }
    },
